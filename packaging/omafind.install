post_install() {
  echo "Open Omafind from the app launcher to set it up (model, folders, shortcut),"
  echo "or run \`omafind setup\` in a terminal."
}

pre_remove() {
  echo "Omafind's per-user pieces stay behind: ~/.config/hypr/omafind.lua (and its line in hyprland.lua), the"
  echo "index and models in ~/.local/share/omafind. Run \`omafind uninstall\` as each user first to take them out."
}
